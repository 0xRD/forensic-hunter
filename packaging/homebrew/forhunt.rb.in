# Generated by scripts/render-formula.sh from packaging/homebrew/forhunt.rb.in
class Forhunt < Formula
  desc "Very fast Windows event log (EVTX) parsing, search and timelines for DFIR"
  homepage "https://github.com/0xRD/forensic-hunter"
  version "@VERSION@"
  license any_of: ["MIT", "Apache-2.0"]

  on_macos do
    depends_on arch: :arm64
    on_arm do
      url "https://github.com/0xRD/forensic-hunter/releases/download/v@VERSION@/forhunt-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA_aarch64-apple-darwin@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/0xRD/forensic-hunter/releases/download/v@VERSION@/forhunt-@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_aarch64-unknown-linux-musl@"
    end
    on_intel do
      url "https://github.com/0xRD/forensic-hunter/releases/download/v@VERSION@/forhunt-@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA_x86_64-unknown-linux-musl@"
    end
  end

  def install
    bin.install "forhunt"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/forhunt --version")
  end
end
